<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VisualGameStudio.Shell.ViewModels.Documents"
             xmlns:editor="using:VisualGameStudio.Editor.Controls"
             xmlns:controls="using:VisualGameStudio.Shell.Views.Controls"
             xmlns:designer="using:VisualGameStudio.Shell.Controls"
             xmlns:designerVm="using:VisualGameStudio.Shell.ViewModels.Designer"
             xmlns:avalonEdit="https://github.com/avaloniaui/avaloniaedit"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="VisualGameStudio.Shell.Views.Documents.CodeEditorDocumentView"
             x:DataType="vm:CodeEditorDocumentViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RowDefinitions="Auto,Auto,*">
    <!-- Find/Replace Bar -->
    <controls:FindReplaceControl x:Name="FindReplaceBar"
                                  Grid.Row="0"
                                  IsVisible="False"
                                  FindNext="OnFindNext"
                                  FindPrevious="OnFindPrevious"
                                  ReplaceRequested="OnReplace"
                                  ReplaceAllRequested="OnReplaceAll"
                                  CloseRequested="OnCloseFindReplace"
                                  SearchTextChangedEvent="OnSearchTextChanged"/>

    <!-- Breadcrumb Bar -->
    <editor:BreadcrumbControl x:Name="BreadcrumbBar"
                               Grid.Row="1"
                               ItemClicked="OnBreadcrumbItemClicked"
                               SiblingSelected="OnBreadcrumbSiblingSelected"/>

    <!-- Editor Content -->
    <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <!-- AvaloniaEdit code editor with syntax highlighting -->
    <editor:CodeEditorControl x:Name="MainEditor"
                              Document="{Binding TextDocument}"
                              TextChanged="OnTextChanged"
                              CaretPositionChanged="OnCaretPositionChanged"
                              AddToWatchRequested="OnAddToWatchRequested"
                              DataTipRequested="OnDataTipRequested"
                              IsVisible="{Binding !IsSplitView}">
      <editor:CodeEditorControl.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Cut" Click="OnCut" InputGesture="Ctrl+X"/>
          <MenuItem Header="Copy" Click="OnCopy" InputGesture="Ctrl+C"/>
          <MenuItem Header="Paste" Click="OnPaste" InputGesture="Ctrl+V"/>
          <Separator/>
          <MenuItem Header="Add to Watch" Click="OnAddToWatch" InputGesture="Shift+F9"/>
          <Separator/>
          <MenuItem Header="Go to Definition" Click="OnGoToDefinition" InputGesture="F12"/>
          <MenuItem Header="Peek Definition" Click="OnPeekDefinition" InputGesture="Alt+F12"/>
          <MenuItem Header="Find All References" Click="OnFindAllReferences" InputGesture="Shift+F12"/>
          <MenuItem Header="Show Call Hierarchy" Click="OnShowCallHierarchy"/>
          <Separator/>
          <MenuItem Header="Surround With..." Click="OnSurroundWith"/>
          <Separator/>
          <MenuItem Header="Rename Symbol..." Click="OnRenameSymbol" InputGesture="Ctrl+R"/>
          <MenuItem Header="Extract Method..." Click="OnExtractMethod" InputGesture="Ctrl+Shift+M"/>
          <MenuItem Header="Inline Method..." Click="OnInlineMethod" InputGesture="Ctrl+Shift+I"/>
          <MenuItem Header="Introduce Variable..." Click="OnIntroduceVariable" InputGesture="Ctrl+Shift+V"/>
          <MenuItem Header="Extract Constant..." Click="OnExtractConstant" InputGesture="Ctrl+Shift+K"/>
          <MenuItem Header="Inline Constant..." Click="OnInlineConstant" InputGesture="Ctrl+Shift+J"/>
          <MenuItem Header="Inline Variable..." Click="OnInlineVariable" InputGesture="Ctrl+Shift+L"/>
          <MenuItem Header="Change Signature..." Click="OnChangeSignature" InputGesture="Ctrl+Shift+S"/>
          <MenuItem Header="Encapsulate Field..." Click="OnEncapsulateField" InputGesture="Ctrl+Shift+E"/>
          <MenuItem Header="Inline Field..." Click="OnInlineField" InputGesture="Ctrl+Shift+F"/>
          <MenuItem Header="Move Type to File..." Click="OnMoveTypeToFile" InputGesture="Ctrl+Shift+T"/>
          <MenuItem Header="Extract Interface..." Click="OnExtractInterface" InputGesture="Ctrl+Shift+X"/>
          <MenuItem Header="Generate Constructor..." Click="OnGenerateConstructor" InputGesture="Ctrl+Shift+G"/>
          <MenuItem Header="Implement Interface..." Click="OnImplementInterface" InputGesture="Ctrl+."/>
          <MenuItem Header="Override Method..." Click="OnOverrideMethod" InputGesture="Ctrl+Shift+O"/>
          <MenuItem Header="Add Parameter..." Click="OnAddParameter" InputGesture="Ctrl+Shift+P"/>
          <MenuItem Header="Remove Parameter..." Click="OnRemoveParameter" InputGesture="Ctrl+Shift+R"/>
          <MenuItem Header="Reorder Parameters..." Click="OnReorderParameters" InputGesture="Ctrl+Shift+U"/>
          <MenuItem Header="Rename Parameter..." Click="OnRenameParameter" InputGesture="Ctrl+Shift+N"/>
          <MenuItem Header="Change Parameter Type..." Click="OnChangeParameterType" InputGesture="Ctrl+Shift+Y"/>
          <MenuItem Header="Make Parameter Optional..." Click="OnMakeParameterOptional" InputGesture="Ctrl+Shift+D"/>
          <MenuItem Header="Make Parameter Required..." Click="OnMakeParameterRequired" InputGesture="Ctrl+Shift+Q"/>
          <MenuItem Header="Convert to Named Arguments..." Click="OnConvertToNamedArguments" InputGesture="Ctrl+Shift+A"/>
          <MenuItem Header="Convert to Positional Arguments..." Click="OnConvertToPositionalArguments" InputGesture="Ctrl+Shift+Z"/>
          <MenuItem Header="Safe Delete..." Click="OnSafeDelete" InputGesture="Alt+Delete"/>
          <MenuItem Header="Pull Members Up..." Click="OnPullMembersUp" InputGesture="Ctrl+Shift+Up"/>
          <MenuItem Header="Push Members Down..." Click="OnPushMembersDown" InputGesture="Ctrl+Shift+Down"/>
          <MenuItem Header="Use Base Type..." Click="OnUseBaseType" InputGesture="Ctrl+Shift+B"/>
          <MenuItem Header="Convert to Interface..." Click="OnConvertToInterface" InputGesture="Ctrl+Shift+W"/>
          <MenuItem Header="Invert If..." Click="OnInvertIf" InputGesture="Ctrl+Shift+H"/>
          <MenuItem Header="Convert to Select Case..." Click="OnConvertToSelectCase" InputGesture="Ctrl+Alt+C"/>
          <MenuItem Header="Split Declaration" Click="OnSplitDeclaration"/>
          <MenuItem Header="Introduce Field..." Click="OnIntroduceField" InputGesture="Ctrl+Alt+F"/>
          <Separator/>
          <MenuItem Header="Toggle Comment" Click="OnToggleComment" InputGesture="Ctrl+OemQuestion"/>
          <Separator/>
          <MenuItem Header="Show File History" Click="OnShowFileHistory"/>
        </ContextMenu>
      </editor:CodeEditorControl.ContextMenu>
    </editor:CodeEditorControl>

    <!-- Split View - Horizontal -->
    <Grid RowDefinitions="*,5,*"
          IsVisible="{Binding IsSplitView}">
      <Grid.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsSplitView"/>
          <Binding Path="SplitOrientation" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="{x:Static vm:SplitOrientation.Horizontal}"/>
        </MultiBinding>
      </Grid.IsVisible>

      <editor:CodeEditorControl x:Name="TopEditor"
                                Grid.Row="0"
                                Document="{Binding TextDocument}"
                                TextChanged="OnTextChanged"
                                CaretPositionChanged="OnCaretPositionChanged"/>

      <!-- Background dropped: the global GridSplitter style (IdeBorder, Dark #3C3C3C) applies. -->
      <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"/>

      <editor:CodeEditorControl x:Name="BottomEditor"
                                Grid.Row="2"
                                Document="{Binding TextDocument}"
                                TextChanged="OnTextChanged"
                                CaretPositionChanged="OnCaretPositionChanged"/>
    </Grid>

    <!-- Split View - Vertical -->
    <Grid ColumnDefinitions="*,5,*">
      <Grid.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsSplitView"/>
          <Binding Path="SplitOrientation" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="{x:Static vm:SplitOrientation.Vertical}"/>
        </MultiBinding>
      </Grid.IsVisible>

      <editor:CodeEditorControl x:Name="LeftEditor"
                                Grid.Column="0"
                                Document="{Binding TextDocument}"
                                TextChanged="OnTextChanged"
                                CaretPositionChanged="OnCaretPositionChanged"/>

      <!-- Background dropped: the global GridSplitter style (IdeBorder, Dark #3C3C3C) applies. -->
      <GridSplitter Grid.Column="1" VerticalAlignment="Stretch"/>

      <editor:CodeEditorControl x:Name="RightEditor"
                                Grid.Column="2"
                                Document="{Binding TextDocument}"
                                TextChanged="OnTextChanged"
                                CaretPositionChanged="OnCaretPositionChanged"/>
    </Grid>

    <!-- Design view. Overlays the editor rather than replacing it: MainEditor and both split
         containers already carry their own IsVisible bindings, and threading a third condition
         through all three is how a rarely-used mode makes the COMMON path go blank. An opaque
         overlay leaves every one of those bindings exactly as it was. -->
    <Border Background="{DynamicResource IdeBg}"
            IsVisible="{Binding IsDesignMode}">
      <!-- Ctrl+Z here, not only in the editor underneath: the canvas takes focus on a click, so
           without these the design view would have no undo at all for the user who never leaves
           it. Both gestures are bound because Ctrl+Y and Ctrl+Shift+Z are each "redo" depending on
           what the user came from. -->
      <Border.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoDesignerEditCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoDesignerEditCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoDesignerEditCommand}"/>
      </Border.KeyBindings>
      <Grid ColumnDefinitions="150,*,260">

        <!-- Toolbox, shaped like Visual Studio's: a panel caption, controls grouped under category
             headers, and one compact row per control — glyph, name, and what it maps to. -->
        <Border Grid.Column="0" Background="{DynamicResource IdePanelBg}"
                BorderBrush="{DynamicResource IdeBorder}" BorderThickness="0,0,1,0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="8,5"
                    BorderBrush="{DynamicResource IdeBorder}" BorderThickness="0,0,0,1">
              <TextBlock Text="Toolbox" FontWeight="SemiBold" FontSize="11"/>
            </Border>

            <!-- Drag a row onto the canvas to place one. PointerPressed is wired in the
                 constructor, NOT here — see the note there; PointerMoved starts the drag once the
                 pointer has actually travelled, so a plain click still just selects. -->
            <ListBox x:Name="ToolboxList"
                     ItemsSource="{Binding Toolbox.Items}"
                     Background="Transparent"
                     BorderThickness="0"
                     PointerMoved="OnToolboxPointerMoved"
                     PointerReleased="OnToolboxPointerReleased">
              <ListBox.Styles>
                <!-- VS rows are one line tall and full width; the default padding makes a toolbox
                     of ten controls scroll for no reason. -->
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="MinHeight" Value="0"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="designerVm:FormToolboxItem">
                  <StackPanel>
                    <!-- The group header, drawn by the FIRST row of each category. -->
                    <TextBlock Text="{Binding Category}"
                               IsVisible="{Binding StartsCategory}"
                               FontSize="10" FontWeight="SemiBold" Opacity="0.55"
                               Margin="6,8,0,3"/>
                    <Grid ColumnDefinitions="26,*" Margin="6,2,4,2" ToolTip.Tip="{Binding Description}">
                      <Border Grid.Column="0" Width="20" Height="16"
                              Background="{DynamicResource IdeBg}"
                              BorderBrush="{DynamicResource IdeBorder}" BorderThickness="1"
                              HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" FontSize="9"
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="12"
                                 VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">
          <designer:FormCanvasControl Grid.Row="0"
                                      x:Name="DesignCanvas"
                                      Document="{Binding DesignDocument}"
                                      ModelRevision="{Binding DesignModelRevision}"
                                      DropCommand="{Binding PlaceDroppedControlCommand}"
                                      CommitGeometryCommand="{Binding CommitGeometryCommand}"
                                      DeleteCommand="{Binding DeleteControlCommand}"
                                      ActivateControlCommand="{Binding ActivateControlCommand}"
                                      Selection="{Binding Selection}"
                                      CopyCommand="{Binding CopyControlsCommand}"
                                      CutCommand="{Binding CutControlsCommand}"
                                      PasteCommand="{Binding PasteControlsCommand}"
                                      TypeHereHost="{Binding StripEditor.Host}"
                                      BeginTypeHereCommand="{Binding BeginTypeHereCommand}"
                                      EditItemCommand="{Binding BeginEditItemCommand}"
                                      EditingItem="{Binding StripEditor.EditTarget}"
                                      SelectedControl="{Binding PropertyGrid.SelectedControl, Mode=TwoWay}"/>

          <!-- Task 24 (24d): the Type Here editor — an in-place TextBox over the menu/tool/status strip
               slot being typed into. Same cell as the canvas and AFTER it, so it paints above.
               ⛔ It is born hidden and has NO Background: while active it covers this whole cell, and a
               Panel with a Background would swallow every click meant for the canvas beneath it.
               ⛔ Every {Binding} here is a REFLECTION binding (this repo has no compiled bindings), so a
               path to a command the toolkit never generated binds to NOTHING with no build error.
               FormStripViewTests resolves each path against the view model by reflection. -->
          <designer:FormTypeHereEditor Grid.Row="0"
                                       x:Name="TypeHereEditor"
                                       IsActive="{Binding StripEditor.IsActive}"
                                       Host="{Binding StripEditor.Host}"
                                       Text="{Binding StripEditor.Text, Mode=TwoWay}"
                                       SlotBounds="{Binding #DesignCanvas.TypeHereBounds}"
                                       CommitCommand="{Binding CommitTypeHereCommand}"
                                       CancelCommand="{Binding CancelTypeHereCommand}"
                                       EditTarget="{Binding StripEditor.EditTarget}"
                                       ActivateCommand="{Binding ActivateControlCommand}"/>

          <!-- Task 25: the component tray — VS's strip under the surface for the things that are
               part of the form but have no position on it. Click selects (through the shared
               Selection, so the canvas pushes it into the property grid), double-click opens the
               default handler, Delete removes, and a toolbox drag can be dropped here.
               ⛔ Focusable="True" is load-bearing: a KeyBinding fires only while keyboard focus is
               INSIDE the element, and a Border is not focusable by default. Without it the tray's
               Delete would be complete, tested and dead the moment the user clicked anything but
               the canvas. OnTrayItemPressed focuses this Border; FormTrayViewTests asserts the
               attribute. -->
          <Border Grid.Row="1" x:Name="ComponentTray" Focusable="True"
                  IsVisible="{Binding Tray.IsVisible}"
                  Background="{DynamicResource IdePanelBg}"
                  BorderBrush="{DynamicResource IdeBorder}" BorderThickness="0,1,0,0"
                  Padding="6,4" DragDrop.AllowDrop="True">
            <Border.KeyBindings>
              <KeyBinding Gesture="Delete" Command="{Binding DeleteControlCommand}"
                          CommandParameter="{Binding PropertyGrid.SelectedControl}"/>
            </Border.KeyBindings>
            <Border.Styles>
              <Style Selector="Border.tray-item">
                <Setter Property="BorderBrush" Value="{DynamicResource IdeBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource IdeBg}"/>
              </Style>
              <Style Selector="Border.tray-item.selected">
                <Setter Property="BorderBrush" Value="#569CD6"/>
              </Style>
            </Border.Styles>
            <ItemsControl ItemsSource="{Binding Tray.Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="designerVm:FormTrayItem">
                  <Border Classes="tray-item" Classes.selected="{Binding IsSelected}"
                          Margin="0,0,8,0" Padding="6,3" CornerRadius="2"
                          PointerPressed="OnTrayItemPressed" DoubleTapped="OnTrayItemDoubleTapped"
                          ToolTip.Tip="{Binding Kind}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Glyph}" FontSize="10"
                                 FontFamily="Cascadia Code, Consolas, monospace"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Id}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </Grid>

        <!-- The Properties window (spec §3) — extracted into its own view, bound to the same
             FormPropertyGridViewModel. ⚠ Two PropertyGrid bindings deliberately STAY in this view:
             the canvas's SelectedControl (TwoWay, above) and the tray Delete's CommandParameter —
             FormTrayViewTests pins the latter, the real-view tests read the former. -->
        <controls:FormPropertyGridView Grid.Column="2" x:Name="PropertyGridView"
                                       DataContext="{Binding PropertyGrid}"/>
      </Grid>
    </Border>

    <!-- Split View Toggle Button -->
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,2,20,0"
                Spacing="2">
      <!-- Design|Code. Only for a form document — every other file has nothing to draw. -->
      <Button Command="{Binding ToggleDesignModeCommand}"
              ToolTip.Tip="Toggle Design / Code view"
              Height="20"
              Padding="6,2"
              Background="Transparent"
              Opacity="0.6"
              IsVisible="{Binding IsFormDocument}">
        <!-- Two labels rather than a value converter: the label is the only thing that varies,
             and a converter would be a new public type, a namespace import and a registration to
             carry one string each way. -->
        <Panel>
          <TextBlock FontSize="10" Foreground="{DynamicResource IdeFg}"
                     Text="Design" IsVisible="{Binding !IsDesignMode}"/>
          <TextBlock FontSize="10" Foreground="{DynamicResource IdeFg}"
                     Text="Code" IsVisible="{Binding IsDesignMode}"/>
        </Panel>
      </Button>
      <Button Command="{Binding SplitHorizontalCommand}"
              ToolTip.Tip="Split Horizontal"
              Width="20" Height="20"
              Padding="2"
              Background="Transparent"
              Opacity="0.6">
        <TextBlock Text="=" FontSize="10" Foreground="{DynamicResource IdeFg}"/>
      </Button>
      <Button Command="{Binding SplitVerticalCommand}"
              ToolTip.Tip="Split Vertical"
              Width="20" Height="20"
              Padding="2"
              Background="Transparent"
              Opacity="0.6">
        <TextBlock Text="||" FontSize="10" Foreground="{DynamicResource IdeFg}"/>
      </Button>
      <Button Command="{Binding CloseSplitCommand}"
              ToolTip.Tip="Close Split"
              Width="20" Height="20"
              Padding="2"
              Background="Transparent"
              Opacity="0.6"
              IsVisible="{Binding IsSplitView}">
        <TextBlock Text="x" FontSize="10" Foreground="{DynamicResource IdeFg}"/>
      </Button>
    </StackPanel>
    </Grid>
  </Grid>

</UserControl>
