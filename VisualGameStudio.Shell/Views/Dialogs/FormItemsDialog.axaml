<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:designerVm="using:VisualGameStudio.Shell.ViewModels.Designer"
        x:Class="VisualGameStudio.Shell.Views.Dialogs.FormItemsDialog"
        x:DataType="designerVm:FormItemsDialogViewModel"
        Title="String Collection Editor"
        Width="420" Height="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource IdeBg}">

  <!-- Slice 4 Task 7: VS's String Collection Editor, opened from an Items row's `…` button. One item per line; OK closes
       with the model value (ADR 0020), Cancel or the close box with none — the row commits, never this dialog.
       ⛔ Every {Binding} is a REFLECTION binding: FormPropertyGridViewTests walks this file against FormItemsDialogViewModel. -->
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Text="Enter the strings in the collection (one per line):" FontSize="11" Margin="0,0,0,4"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <!-- ⚠ OK is NOT IsDefault: Enter in the box is a new line, as in VS's editor. -->
      <Button x:Name="OkButton" Content="OK" Padding="16,3" Click="OnOk"/>
      <Button x:Name="CancelButton" Content="Cancel" Padding="16,3" IsCancel="True" Click="OnCancel"/>
    </StackPanel>
    <TextBox x:Name="ItemsBox" AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
             AutomationProperties.Name="The strings in the collection, one per line"
             Text="{Binding Text, Mode=TwoWay}"/>
  </DockPanel>
</Window>
