<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VisualGameStudio.Tests</RootNamespace>
    <AssemblyName>VisualGameStudio.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Suppress async/threading warnings for test code -->
    <NoWarn>$(NoWarn);CS1998;VSTHRD103;VSTHRD200</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="NUnit" Version="4.0.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <!-- ⛔ The designer canvas and the toolbox drag are VIEW code, and view code is where every
         unreachable piece of this feature hid: FIVE shipped complete, unit-tested and never
         executed, with the suite green throughout. Nothing could drive a real Avalonia control
         here, so "not visually verified" was written into FormCanvasControl itself and believed.

         It is verifiable. Headless restores and runs, and with Skia it RENDERS, so a test can
         drive the actual control and compare the actual pixels — which is the only thing that
         would have caught a canvas drawing all ten control kinds as the same grey box.

         ⚠ Avalonia.Headless.NUnit is what makes it usable from NUnit: [AvaloniaTest] runs the
         body on the dispatcher thread. Without it the control constructs on a worker thread and
         fails in ways that look like product bugs. -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.13" />
    <PackageReference Include="Avalonia.Headless.NUnit" Version="11.3.13" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.13" />
    <!-- Roslyn: compile-and-run the C# the backend generates, proving the SAME BasicLang
         source that runs on the C++ backend also runs on the C# backend (Task 3 portability). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
    <!-- ⛔ The WinForms REFERENCE assemblies, and the reason the designer's control catalog is
         falsifiable at all. WinForms has no type metadata at any layer this compiler can see:
         EnableNetResolution returns early for UseWindowsForms, the resolver closure cannot reach
         System.Windows.Forms.dll, and every Form/Button/Point member therefore types as Object
         with NO diagnostic — a misspelled property name compiles green. csc is the only thing
         that says otherwise, and these are what let it run.

         Referenced as a plain NuGet package rather than found through the installed SDK on
         purpose: reference-only compilation is cross-platform (the assemblies are metadata, not
         code), so this works on Linux where the WindowsDesktop SDK targets do not exist at all.
         Restore therefore guarantees it is present on every platform, which is what lets
         WinFormsCompile FAIL when the pack is missing instead of quietly skipping — a catalog
         gate that can no-op is worth less than no gate, because it reports success. -->
    <PackageReference Include="Microsoft.WindowsDesktop.App.Ref" Version="8.0.31"
                      GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Surfaced to the test assembly so WinFormsCompile can find the pack without guessing at
         a NuGet cache layout. -->
    <AssemblyMetadata Include="WindowsDesktopRefPath"
                      Value="$(PkgMicrosoft_WindowsDesktop_App_Ref)/ref/net8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0004 D2 / ADR-0005 D2: the post-optimizer IR verifier (Invariant S′) is ON in the
         suite. The suite builds -c Release, where a Debug.Assert would compile away, so the
         compiler reads this runtime switch instead (IRVerifier.SwitchName). It lands in the
         test host's runtimeconfig.json; shipping BasicLang/IDE builds never set it. Any
         OptimizationPipeline.Run in the test process then throws IRVerificationException on a
         violation. Override per run with BASICLANG_VERIFY_IR=0 | log:<path>. -->
    <RuntimeHostConfigurationOption Include="BasicLang.VerifyIR" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BasicLang\BasicLang.csproj" />
    <ProjectReference Include="..\VisualGameStudio.Core\VisualGameStudio.Core.csproj" />
    <ProjectReference Include="..\VisualGameStudio.Editor\VisualGameStudio.Editor.csproj" />
    <ProjectReference Include="..\VisualGameStudio.ProjectSystem\VisualGameStudio.ProjectSystem.csproj" />
    <!-- Shell VMs (e.g. ErrorListViewModel) are unit-tested for their count/filter contract. -->
    <ProjectReference Include="..\VisualGameStudio.Shell\VisualGameStudio.Shell.csproj" />
    <!-- Ships RaylibWrapper.dll next to the test host so in-process game builds
         resolve the engine wrapper exactly like the IDE/BasicLang.exe deployments
         (EngineDeployment probes the process base directory). -->
    <ProjectReference Include="..\RaylibWrapper\RaylibWrapper.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships the engine import lib + native DLL (prebuilt IDE/ layout) next to
         the test host — which is also where BasicLang.exe deploys — so
         Language=Cpp game builds (CppProjectBuilder / CLI e2e) link and deploy
         the engine exactly like a shipped install (EngineDeployment.LocateImportLib
         probes the process base directory). -->
    <None Include="..\IDE\VisualGameStudioEngine.lib" Link="VisualGameStudioEngine.lib" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\IDE\VisualGameStudioEngine.dll" Link="VisualGameStudioEngine.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="TestAssets\BlnetTestShim\BlnetTestShim.csproj" />
    <!-- The test csproj uses default SDK globs with NO existing Compile excludes: without this
         Remove, the shim's sources (and its nested obj\ generated AssemblyInfo files) are
         double-compiled into the test assembly -> CS0436 type conflicts + CS0579 duplicate
         attributes. Required, not conditional. -->
    <Compile Remove="TestAssets\**" />
    <!-- Task 9's fixture reads main.cpp.txt from TestContext.CurrentContext.TestDirectory;
         'Update' (not 'Include') because a .txt is already a default None item. Harmless
         MSBuild no-op until Task 9 creates the file. -->
    <None Update="TestAssets\BlnetHarness\main.cpp.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
