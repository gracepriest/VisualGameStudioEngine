<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>NewCOM Component</Name>
    <Description>A NewCOM component project that can be used from both BasicLang and C++.</Description>
    <ProjectType>VisualBasic</ProjectType>
    <LanguageTag>visualbasic</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <PlatformTag>Linux</PlatformTag>
    <PlatformTag>macOS</PlatformTag>
    <ProjectTypeTag>Library</ProjectTypeTag>
    <SortOrder>1100</SortOrder>
    <TemplateID>BasicLang.NewComComponent</TemplateID>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>NewComComponent</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <Hidden>false</Hidden>
  </TemplateData>
  <TemplateContent>
    <Project File="Project.blproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="component.h">component.h</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="component.cpp">component.cpp</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="component.bas">component.bas</ProjectItem>
    </Project>
  </TemplateContent>
</VSTemplate>
