' greeter.bas — BasicLang binding for NewCOM Greeter component
' Uses the C ABI factory and vtable dispatch via helper functions.

Declare Function Greeter_Create Lib "greeter_newcom" () As Integer
Declare Function Greeter_SayHello Lib "greeter_newcom" (h As Integer, name As String, ByRef outMsg As String) As Integer
Declare Function Greeter_GetCount Lib "greeter_newcom" (h As Integer, ByRef outCount As Integer) As Integer
Declare Sub Greeter_Release Lib "greeter_newcom" (h As Integer)

' Helper wrappers that handle the vtable indirection.
' (In a full implementation, these would be generated by the NewCOM tool.)

Class Greeter
    Private _handle As Integer

    Public Sub New()
        _handle = Greeter_Create()
    End Sub

    Public Function SayHello(name As String) As String
        Dim msg As String = ""
        Greeter_SayHello(_handle, name, msg)
        Return msg
    End Function

    Public Function GetCount() As Integer
        Dim c As Integer = 0
        Greeter_GetCount(_handle, c)
        Return c
    End Function

    Public Sub Close()
        Greeter_Release(_handle)
        _handle = 0
    End Sub
End Class
