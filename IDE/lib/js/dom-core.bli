' dom-core.bli — DOM declarations for the JavaScript backend (plan 2c).
'
' Auto-included in every JavaScript build (BasicCompiler.DomDeclarationsPath). Every type
' here is an Extern Class: it EMITS NOTHING — the browser already provides it — and its
' members carry the EXACT JavaScript names (decision 2), so a BasicLang call is the real
' call. Case does not matter at the use site: el.TextContent reaches textContent.
'
' Obtain the runtime objects through the hatch, then everything is typed:
'
'     Dim d As Document = ::document
'     Dim w As Window = ::window
'     Dim el As Element = d.getElementById("out")
'     el.textContent = "hello"
'     el.addEventListener("click", Sub(e As DomEvent) Console.WriteLine(e.target.id))
'
' `console` is deliberately absent: Console.WriteLine already lowers to console.log, and a
' declared `console` would collide with that surface (BL7011). Anything not declared here is
' still reachable untyped through `::` or verbatim through javascript{ }.

Public Extern Class Document
    Public Property title As String
    Public Property body As Element
    Public Property documentElement As Element
    Public Function getElementById(id As String) As Element
    Public Function querySelector(selectors As String) As Element
    Public Function createElement(tagName As String) As Element
    Public Function createTextNode(data As String) As Element
    Public Property styleSheets As CSSStyleSheetList
    Public Sub addEventListener(eventType As String, listener As Action(Of DomEvent))
    Public Sub removeEventListener(eventType As String, listener As Action(Of DomEvent))
End Class

Public Extern Class Element
    Public Property id As String
    Public Property tagName As String
    Public Property className As String
    Public Property textContent As String
    Public Property innerHTML As String
    Public Property innerText As String
    Public Property value As String
    Public Property checked As Boolean
    Public Property disabled As Boolean
    Public Property hidden As Boolean
    Public Property parentElement As Element
    Public Property firstElementChild As Element
    Public Property nextElementSibling As Element
    Public Property style As CSSStyleDeclaration
    Public Property classList As DOMTokenList
    Public Property clientWidth As Integer
    Public Property clientHeight As Integer
    Public Property offsetWidth As Integer
    Public Property offsetHeight As Integer
    Public Function getBoundingClientRect() As DOMRect
    Public Function querySelector(selectors As String) As Element
    Public Function closest(selectors As String) As Element
    Public Function contains(other As Element) As Boolean
    Public Function getAttribute(name As String) As String
    Public Sub setAttribute(name As String, attributeValue As String)
    Public Sub removeAttribute(name As String)
    Public Function appendChild(child As Element) As Element
    Public Function removeChild(child As Element) As Element
    Public Sub remove()
    Public Sub focus()
    Public Sub click()
    Public Sub addEventListener(eventType As String, listener As Action(Of DomEvent))
    Public Sub removeEventListener(eventType As String, listener As Action(Of DomEvent))
End Class

Public Extern Class CSSStyleDeclaration
    Public Property color As String
    Public Property backgroundColor As String
    Public Property display As String
    Public Property visibility As String
    Public Property width As String
    Public Property height As String
    Public Property fontSize As String
    Public Property fontWeight As String
    Public Property fontFamily As String
    Public Property fontStyle As String
    Public Property cursor As String
    Public Property margin As String
    Public Property padding As String
    Public Property border As String
    Public Property opacity As String
    Public Property position As String
    Public Property left As String
    Public Property top As String
    Public Property right As String
    Public Property bottom As String
End Class

Public Extern Class DOMTokenList
    Public Property length As Integer
    Public Sub add(token As String)
    Public Sub remove(token As String)
    Public Function toggle(token As String) As Boolean
    Public Function contains(token As String) As Boolean
End Class

' Named DomEvent rather than Event: `Event` is a BasicLang keyword. The type name is never
' emitted (an Extern Class emits nothing), only its members are, so the JS name matters for
' members alone.
Public Extern Class DomEvent
    Public Property target As Element
    Public Property currentTarget As Element
    Public Property key As String
    Public Property code As String
    Public Property clientX As Integer
    Public Property clientY As Integer
    Public Property button As Integer
    Public Property buttons As Integer
    Public Property detail As Integer
    Public Property relatedTarget As Element
    Public Property ctrlKey As Boolean
    Public Property shiftKey As Boolean
    Public Property altKey As Boolean
    Public Sub preventDefault()
    Public Sub stopPropagation()
End Class

Public Extern Class Window
    Public Property document As Document
    Public Property innerWidth As Integer
    Public Property innerHeight As Integer
    Public Property location As Location
    Public Sub alert(message As String)
    Public Function confirm(message As String) As Boolean
    Public Function prompt(message As String) As String
    Public Function setTimeout(handler As Action, milliseconds As Integer) As Integer
    Public Function setInterval(handler As Action, milliseconds As Integer) As Integer
    Public Sub clearTimeout(handle As Integer)
    Public Sub clearInterval(handle As Integer)
    Public Function requestAnimationFrame(callback As Action) As Integer
    Public Function getComputedStyle(element As Element) As CSSStyleDeclaration
    Public Sub addEventListener(eventType As String, listener As Action(Of DomEvent))
End Class

Public Extern Class Location
    Public Property href As String
    Public Property pathname As String
    Public Property search As String
    Public Property hash As String
    Public Sub reload()
End Class

Public Extern Class DOMRect
    Public Property left As Double
    Public Property top As Double
    Public Property right As Double
    Public Property bottom As Double
    Public Property width As Double
    Public Property height As Double
End Class

Public Extern Class CSSStyleSheetList
    Public Property length As Integer
    Public Function item(index As Integer) As CSSStyleSheet
End Class

Public Extern Class CSSStyleSheet
    Public Property cssRules As CSSRuleList
    Public Function insertRule(rule As String, index As Integer) As Integer
    Public Sub deleteRule(index As Integer)
End Class

Public Extern Class CSSRuleList
    Public Property length As Integer
    Public Function item(index As Integer) As CSSRule
End Class

Public Extern Class CSSRule
    Public Property style As CSSStyleDeclaration
End Class

Public Extern Class CSSStyleRule
    Public Property selectorText As String
    Public Property style As CSSStyleDeclaration
End Class

Public Extern Class CSSMediaRule
    Public Property conditionText As String
    Public Property cssRules As CSSRuleList
End Class
